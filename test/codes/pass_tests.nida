class Counter:
    def void __init__(self):
        self.count = 0

    def void increment(self):
        step = 1
        self.count = self.count + step

#nida_test

class Calculator:
    def int double_val(self, int x):
        return x * 2

    def int compute(self, int a):
        temp = self.double_val(a)
        return temp

